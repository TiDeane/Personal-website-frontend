---
import { Icon } from 'astro-icon/components';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Props {
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], footNote = '', theme = 'light' } = Astro.props;

const API_URL = "https://tiagodeane.com/top";
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="md:flex md:items-center md:justify-between py-4 md:py-6">
      
      <div id="visitor-container" class="hidden md:hidden md:inline-flex items-center text-xs text-gray-500 dark:text-slate-400">
        <span class="flex h-2 w-2 rounded-full bg-green-500 mr-2 animate-pulse"></span>
        <span id="visitor-message"></span>
      </div>

      <div class="text-sm dark:text-muted mt-2 md:mt-0">
        <div class="whitespace-nowrap">
          <Fragment set:html={footNote} />
        </div>
      </div>

      <!-- "hidden" class is removed if API Gateway fetch fails -->
      <div id="social-links" class="hidden">
        {
          socialLinks?.length ? (
            <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
              {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                <li>
                  <a
                    class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="w-5 h-5" />}
                    <Fragment set:html={text} />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            ''
          )
        }
      </div>
      
    </div>
  </div>
</footer>


<!-- Top countries by visitor count display -->
<script define:vars={{ API_URL }} is:inline>
  
  // from "https://dev.to/jorik/country-code-to-flag-emoji-a21"
  const getFlagEmoji = (countryCode) => {
    if (!countryCode) return '🌐';
    const codePoints = countryCode
      .toUpperCase()
      .split('')
      .map(char => 127397 + char.charCodeAt(0));
    return String.fromCodePoint(...codePoints);
};

  async function fetchStats() {   
    const container = document.getElementById('visitor-container');
    const socials = document.getElementById('social-links');
    const message = document.getElementById('visitor-message');
    
    try {
      const response = await fetch(API_URL);
      if (!response.ok) throw new Error('Failed when fetching top countries from API Gateway');

      const data = await response.json();

      if (data?.topCountries?.length > 0) {
        const countries = data.topCountries.map(c => {
          const flag = getFlagEmoji(c.countryCode);
          return `${flag} ${c.countryName} (${c.count})`;
        });
        
        message.textContent = `Top visitors: ${countries.join(', ')}`;
        container.classList.remove('md:hidden');
      }
    } catch (error) {
      socials.classList.remove('hidden');
      console.log('Error: analytics unavailable');
    }
  }

  fetchStats();
</script>
