---
import { Icon } from 'astro-icon/components';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Props {
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="md:flex md:items-center md:justify-between md:gap-6 py-4 md:py-6">
      <!-- "hidden" class is removed once top countries are fetched -->
      <div id="visitor-container" class="hidden flex-wrap items-center gap-2 text-sm text-black dark:text-muted">
        <span class="inline-flex items-center mr-1">
          <span class="flex h-2 w-2 rounded-full bg-green-500 mr-2 animate-pulse"></span>
          Top visitors
        </span>
        <ul id="visitor-list" class="contents"></ul>
      </div>

      <div class="text-sm dark:text-muted mt-3 md:mt-0">
        <div class="whitespace-nowrap">
          <Fragment set:html={footNote} />
        </div>
      </div>

      <!-- "hidden" class is removed if API Gateway fetch fails -->
      <div id="social-links" class="hidden">
        {
          socialLinks?.length ? (
            <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0 rtl:ml-0 rtl:-mr-2 rtl:md:ml-0 rtl:md:mr-4">
              {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                <li>
                  <a
                    class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="w-5 h-5" />}
                    <Fragment set:html={text} />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            ''
          )
        }
      </div>
      
    </div>
  </div>
</footer>


<!-- Top countries by visitor count display -->
<script>
  import { polyfillCountryFlagEmojis } from 'country-flag-emoji-polyfill';
  import flagFontUrl from 'country-flag-emoji-polyfill/dist/TwemojiCountryFlags.woff2?url';

  interface TopCountry {
    countryName: string;
    countryCode: string;
    count: number;
  }

  const API_URL = 'https://tiagodeane.com/top';

  // The API only allows the production origin, so dev builds render placeholder data instead
  const PLACEHOLDER_COUNTRIES: TopCountry[] = [
    { countryName: 'Portugal', countryCode: 'PT', count: 1111 },
    { countryName: 'United States', countryCode: 'US', count: 266 },
    { countryName: 'Singapore', countryCode: 'SG', count: 41 },
  ];

  // Chromium on Windows has no flag emoji glyphs; this loads a flag-only font there and nowhere else
  polyfillCountryFlagEmojis('Twemoji Country Flags', flagFontUrl);

  // from "https://dev.to/jorik/country-code-to-flag-emoji-a21"
  const getFlagEmoji = (countryCode: string) => {
    if (!countryCode) return '🌐';
    const codePoints = countryCode
      .toUpperCase()
      .split('')
      .map((char) => 127397 + char.charCodeAt(0));
    return String.fromCodePoint(...codePoints);
  };

  async function getTopCountries(): Promise<TopCountry[]> {
    if (import.meta.env.DEV) return PLACEHOLDER_COUNTRIES;

    const response = await fetch(API_URL);
    if (!response.ok) throw new Error('Failed when fetching top countries from API Gateway');
    const data = await response.json();
    return data?.topCountries ?? [];
  }

  async function renderTopCountries() {
    const container = document.getElementById('visitor-container');
    const socials = document.getElementById('social-links');
    const list = document.getElementById('visitor-list');
    if (!container || !socials || !list) return;

    try {
      const countries = await getTopCountries();
      if (!countries.length) throw new Error('No top countries returned');

      for (const c of countries) {
        const chip = document.createElement('li');
        chip.className =
          'inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-slate-700 bg-black/5 dark:bg-white/5 px-2.5 py-0.5 transition hover:border-gray-400 dark:hover:border-slate-400';

        const flag = document.createElement('span');
        flag.style.fontFamily = '"Twemoji Country Flags", sans-serif';
        flag.setAttribute('aria-hidden', 'true');
        flag.textContent = getFlagEmoji(c.countryCode);

        const name = document.createElement('span');
        name.textContent = c.countryName;

        const count = document.createElement('span');
        count.className = 'tabular-nums text-muted dark:text-slate-400';
        count.textContent = Number(c.count).toLocaleString('en-US');

        chip.append(flag, name, count);
        list.append(chip);
      }

      container.classList.replace('hidden', 'flex');
    } catch {
      socials.classList.remove('hidden');
      console.log('Error: analytics unavailable');
    }
  }

  renderTopCountries();
</script>
