---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

export interface ResumeStepItem {
  title: string;
  subtitle?: string;
  dateRange?: string;
  description?: string;
  bullets?: string[];
  icon?: string;
}

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  items?: ResumeStepItem[];
  isDark?: boolean;
  classes?: {
    container?: string;
    headline?: Record<string, unknown>;
  };
  bg?: string;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl ${classes?.container ?? ''}`} bg={bg}>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'text-left rtl:text-right',
      title: 'text-3xl lg:text-4xl',
      ...((classes?.headline as object) ?? {}),
    }}
  />

  <div class="divide-y divide-gray-200 dark:divide-slate-700">
    {
      items.map((item) => (
        <div class="py-6 first:pt-0 last:pb-0 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
          <div class="flex items-start gap-4">
            {item.icon && <Icon name={item.icon} class="w-6 h-6 mt-1 shrink-0 text-primary dark:text-blue-200" />}
            <div class="w-full">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-lg md:text-xl font-bold font-heading dark:text-gray-200">
                  {item.title}
                  {item.subtitle && <span class="font-normal text-muted dark:text-slate-400"> · {item.subtitle}</span>}
                </h3>
                {item.dateRange && (
                  <span class="text-sm text-muted dark:text-slate-400 whitespace-nowrap">{item.dateRange}</span>
                )}
              </div>

              {item.description && <p class="mt-2 text-muted dark:text-slate-300" set:html={item.description} />}

              {item.bullets && item.bullets.length > 0 && (
                <ul class="mt-2 space-y-1 list-disc list-inside text-muted dark:text-slate-300">
                  {item.bullets.map((bullet) => (
                    <li set:html={bullet} />
                  ))}
                </ul>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
