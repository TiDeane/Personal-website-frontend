---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import ContactSocial from '~/components/widgets/ContactSocial.astro';

import profilePicture from '~/assets/images/profile.png';
import { Image } from 'astro:assets';
---

<Layout>
  <Fragment slot="header">
    <Header links={[]} isSticky showToggleTheme position="right" />
  </Fragment>

  <section class="relative flex items-center min-h-screen px-4">
    <div class="max-w-2xl mx-auto text-center">
      <Image
        src={profilePicture}
        alt="Tiago Deane profile picture"
        width={128}
        height={128}
        loading="eager"
        class="mx-auto rounded-full w-32 h-32 object-cover mb-6"
      />

      <h1 class="text-4xl md:text-5xl font-bold font-heading dark:text-gray-200 mb-4">
        Tiago Deane
      </h1>

      <p class="text-xl text-muted dark:text-slate-300 mb-2">
        Software Engineer at Mastercard.
      </p>

      <p class="text-base text-secondary dark:text-blue-200 font-semibold uppercase tracking-wide mb-10">
        Website under development — check back soon
      </p>

      <ContactSocial
        title=""
        items={[
          {
            label: 'Email',
            icon: 'tabler:mail',
            url: 'mailto:tiagodeane@gmail.com',
          },
          {
            label: 'Github',
            icon: 'tabler:brand-github',
            url: 'https://github.com/TiDeane',
          },
          {
            label: 'LinkedIn',
            icon: 'tabler:brand-linkedin',
            url: 'https://www.linkedin.com/in/tiago-deane/',
          },
        ]}
        classes={{ container: 'max-w-3xl mx-auto' }}
      />
    </div>
  </section>
</Layout>
