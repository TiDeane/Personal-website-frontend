---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import ResumeSteps from '~/components/widgets/ResumeSteps.astro';
import Marquee from '~/components/widgets/Marquee.astro';
import Certifications from '~/components/widgets/Certifications.astro';
import ContactSocial from '~/components/widgets/ContactSocial.astro';
import OffTheClock from '~/components/widgets/OffTheClock.astro';
import LottiePlayer from '~/components/common/LottiePlayer.astro';

import profilePicture from '~/assets/images/profile.png';

const logos = [
  { src: '/skills/javascript.svg', label: 'JavaScript' },
  { src: '/skills/tailwindcss.svg', label: 'CSS' },
  { src: '/skills/amazonwebservices.svg', label: 'AWS' },
  { src: '/skills/python.svg', label: 'Python' },
  { src: '/skills/c.svg', label: 'C' },
  { src: '/skills/java.svg', label: 'Java' },
  { src: '/skills/docker.svg', label: 'Docker' },
  { src: '/skills/postgresql.svg', label: 'SQL' },
  { src: '/skills/dynamodb.svg', label: 'NoSQL' },
];

const certs = [
  {
    src: '/certs/AWS_Cloud_Practitioner.png',
    title: 'AWS Certified Cloud Practitioner',
    url: 'https://www.credly.com/badges/9d94075d-c315-4582-9c3e-73b7f2b26f3e/public_url',
  },
  {
    src: '/certs/AWS_Solutions_Architect.png',
    title: 'AWS Certified Solutions Architect',
    url: 'https://www.credly.com/badges/90b1dff1-8827-4d07-ba9f-24471da65096/public_url',
  },
  {
    src: '/certs/AWS_Developer.png',
    title: 'AWS Certified Developer',
    url: 'https://www.credly.com/badges/208bf604-03a4-4d24-a1e4-43dfabd9b601/public_url',
  },
];
---

<Layout>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'About', href: '#about' },
        { text: 'Experience', href: '#experience' },
        { text: 'Education', href: '#education' },
        { text: 'Skills', href: '#skills' },
        { text: 'Certifications', href: '#certs' },
        { text: 'Contact', href: '#contact' },
      ]}
      isSticky
      showToggleTheme
      position="right"
    />
  </Fragment>

  <!-- Hero Section ******************* -->

  <Hero2
    id="about"
    title="Tiago Deane"
    resumeHref="/resume.pdf"
    image={{
      src: profilePicture,
      alt: 'Tiago Deane profile picture',
      loading: 'eager',
    }}
  >
    <Fragment slot="subtitle"> Software Engineer at Mastercard. </Fragment>
    <Fragment slot="content">
      Passionate about building scalable, reliable systems, with a background in distributed systems and cloud
      computing.
    </Fragment>
  </Hero2>

  <!-- Scroll animation -->

  <LottiePlayer
    src="/ui/scroll.json"
    class="mx-auto w-8 h-8 opacity-80 dark:opacity-50 -mt-16 lg:mb-8 hidden lg:block"
  />

  <!-- Work Experience section ****************** -->

  <!-- TODO: after a couple months of experience, add tech stack -->
  <ResumeSteps
    id="experience"
    title="Work Experience"
    items={[
      {
        title: 'Software Engineer I',
        subtitle: 'Mastercard, Lisbon',
        dateRange: 'Sep 2026 - Present',
        bullets: [
          'On the Digital Authentication Services team, a platform providing secure, scalable authentication across digital payments.',
          'Contributing to authentication capabilities such as biometrics, passkeys and 3DS.',
        ],
        icon: 'tabler:briefcase',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-x-0 inset-y-6 md:inset-y-8 lg:inset-y-10 bg-black/5 dark:bg-white/5"></div>
    </Fragment>
  </ResumeSteps>

  <!-- Education section ****************** -->

  <!-- TODO: link thesis (and paper) after completion -->
  <!-- TODO: maybe make a dedicated section for the paper, if EuroSys accepts it :D -->
  <ResumeSteps
    id="education"
    title="Education"
    classes={{ container: 'pt-10 md:pt-28 lg:pt-[7.5rem] pb-16 md:pb-36 lg:pb-40' }}
    items={[
      {
        title: 'Master in Computer Science and Engineering',
        subtitle: 'Técnico, University of Lisbon',
        dateRange: '2024 - 2026',
        bullets: [
          'Specialized in Software Engineering and Distributed Systems.',
          '<b>Thesis</b>: Triage: Automating Decision-making for Optimizing Serverless Fuctions with a Utility-driven Framework.',
          'Awarded a <a href="https://conselhopedagogico.tecnico.ulisboa.pt/premios-e-projetos/quadro-e-diplomas-de-merito/quadro-de-merito-academico-2024-2025/" target="_blank" rel="noopener noreferrer" class="font-normal underline dark:hover:text-white/95 hover:text-primary transition">Diploma of Academic Merit</a> for the 2024/2025 academic year.',
          'Master\'s project portfolio available on <a href="https://github.com/TiDeane/TiDeane/blob/main/IST_MEIC-A.md" class="font-normal underline dark:hover:text-white/95 hover:text-primary transition">Github</a>.',
        ],
        icon: 'tabler:school',
      },
      {
        title: 'Bachelor in Computer Science and Engineering',
        subtitle: 'Técnico, University of Lisbon',
        dateRange: '2021 - 2024',
        bullets: [
          'Bachelor\'s project portfolio available on <a href="https://github.com/TiDeane/TiDeane/blob/main/IST_LEIC-A.md" class="font-normal underline dark:hover:text-white/95 hover:text-primary transition">Github</a>.',
        ],
        icon: 'tabler:school',
      },
    ]}
  />

  <!-- Skills section ****************** -->

  <Marquee id="skills" title="Skills & Technologies" items={logos} duration={20} classes={{ container: '' }}>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-black/5 dark:bg-white/5"></div>
    </Fragment>
  </Marquee>

  <!-- Certifications section ****************** -->

  <Certifications id="certs" title="Certifications" certs={certs} classes={{ container: 'pt-16 md:pt-36 lg:py-40' }} />

  <!-- Contact section ****************** -->

  <ContactSocial
    id="contact"
    title="Contact me"
    items={[
      {
        label: 'Email',
        icon: 'tabler:mail',
        url: 'mailto:tiagodeane@gmail.com',
      },
      {
        label: 'Github',
        icon: 'tabler:brand-github',
        url: 'https://github.com/TiDeane',
      },
      {
        label: 'LinkedIn',
        icon: 'tabler:brand-linkedin',
        url: 'https://www.linkedin.com/in/tiago-deane/',
      },
    ]}
    classes={{ container: 'max-w-3xl pt-6 md:pt-8 lg:pt-0 lg:pb-20' }}
  />

  <OffTheClock
    id="off-the-clock"
    text="Off the clock, I'm usually reading or watching something!"
    items={[
      { label: 'Goodreads', icon: 'simple-icons:goodreads', url: 'https://www.goodreads.com/tideane' },
      { label: 'Letterboxd', icon: 'simple-icons:letterboxd', url: 'https://letterboxd.com/TDeane' },
      { label: 'MyAnimeList', icon: 'simple-icons:myanimelist', url: 'https://myanimelist.net/profile/Deane' },
    ]}
  />
</Layout>
